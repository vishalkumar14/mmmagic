# Windows checkouts default to core.autocrlf=true. Left unmanaged, that rewrites
# line endings on checkout — which would corrupt every binary fixture and the
# compiled magic database, and the resulting MIME-detection failures would look
# like addon bugs rather than checkout damage.

# Never touch these.
*.mgc   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.zip   binary
*.pdf   binary
*.tgz   binary
*.gz    binary

# Text fixtures: pin to LF so the same bytes are inspected on every platform.
# libmagic reports text/plain for both LF and CRLF, but the default
# MAGIC_NONE description does change ("ASCII text" vs "ASCII text, with CRLF
# line terminators"), so keeping them stable keeps assertions meaningful.
test/fixtures/*.txt  text eol=lf
test/fixtures/*.csv  text eol=lf
test/fixtures/*.json text eol=lf
test/fixtures/*.xml  text eol=lf

# Shell scripts and container files must stay LF or they break under bash.
*.sh        text eol=lf
Dockerfile  text eol=lf

# Source: normalise in the repo, let git hand out native endings on checkout.
*.c   text
*.h   text
*.cc  text
*.js  text
*.json text
*.yml text
*.md  text
*.gyp text

# --- Fixtures added with the Windows verification work ------------------------
# Encoding/line-ending-sensitive CSV fixtures. These MUST be byte-exact: the
# whole point of csv-crlf.csv is that it contains CRLF, and the eol=lf rule
# above would rewrite it on checkout (1893 -> 1852 bytes), turning
# "ASCII text, with CRLF line terminators" into plain "ASCII text" and leaving
# the assertion passing while testing nothing. -text disables all conversion.
test/fixtures/csv-crlf.csv      -text
test/fixtures/csv-utf16.csv     -text
test/fixtures/csv-utf8-bom.csv  -text

# Remaining binary fixture types. Git's NUL-byte heuristic would usually get
# these right, but the existing rules above are explicit and these should match.
*.gif   binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.webp  binary
*.ico   binary
*.tar   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.ods   binary
*.odt   binary
